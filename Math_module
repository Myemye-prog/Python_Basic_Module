"""
| Function            | Description             | Example                       |
| ------------------- | ----------------------- | ----------------------------- |
| `math.sqrt(x)`      | Square root             | `math.sqrt(25)` → `5.0`       |
| `math.pow(x, y)`    | x raised to power y     | `math.pow(2, 3)` → `8.0`      |
| `math.factorial(n)` | Factorial of n          | `math.factorial(5)` → `120`   |
| `math.ceil(x)`      | Round up                | `math.ceil(4.2)` → `5`        |
| `math.floor(x)`     | Round down              | `math.floor(4.8)` → `4`       |
| `math.fabs(x)`      | Absolute value          | `math.fabs(-7)` → `7.0`       |
| `math.gcd(a, b)`    | Greatest common divisor | `math.gcd(12, 18)` → `6`      |
| `math.sin(x)`       | Sine (radians)          | `math.sin(math.pi/2)` → `1.0` |
| `math.cos(x)`       | Cosine (radians)        | `math.cos(0)` → `1.0`         |
| `math.tan(x)`       | Tangent (radians)       | `math.tan(math.pi/4)` → `1.0` |
| `math.log(x)`       | Natural logarithm       | `math.log(math.e)` → `1.0`    |
| `math.log10(x)`     | Base-10 logarithm       | `math.log10(100)` → `2.0`     |
| `math.exp(x)`       | e^x                     | `math.exp(2)` → `7.389...`    |

"""
import math as m

# 1. sqrt(x) → Square root
a = 2
print(m.sqrt(a))          # √2 → 1.414...

# 2. pow(x, y) → x raised to the power y
print(m.pow(2, 2))        # 2² → 4.0

# 3. factorial(n) → n!
a = 4
print(m.factorial(a))     # 4! = 4 × 3 × 2 × 1 = 24


# 4. ceil(x) → Round UP to the nearest integer
a = 4.6
print(m.ceil(a))          # 5


# 5. floor(x) → Round DOWN to the nearest integer
print(m.floor(a))         # 4


# 6. fabs(x) → Absolute value
a = -7
print(m.fabs(a))          # |-7| = 7.0


# 7. gcd(a, b) → Greatest Common Divisor
print(m.gcd(45, 90))      # 45
# 45 is the biggest number that divides both 45 and 90 exactly


# 8. sin(x) → Sine
# IMPORTANT: x must be in radians
print(m.sin(m.pi / 2))    # sin(90°) = 1.0


# 9. cos(x) → Cosine
# IMPORTANT: x must be in radians
print(m.cos(0))           # cos(0°) = 1.0


# 10. tan(x) → Tangent
# IMPORTANT: x must be in radians
print(m.tan(m.pi / 4))    # tan(45°) = 1.0


# 11. log(x) → Natural logarithm (base e)
print(m.log(m.e))         # logₑ(e) = 1.0


# 12. log10(x) → Logarithm with base 10
print(m.log10(100))       # log₁₀(100) = 2.0


# 13. exp(x) → e raised to the power x
print(m.exp(2))           # e² = 7.389...
